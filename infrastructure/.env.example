# Copy to `.env.local` before the first `compose up`. `.env.local` is
# gitignored — no secret in this project is ever committed
# (`specs/12-devops-and-environments.md`).
#
#     cp infrastructure/.env.example infrastructure/.env.local
#
# Every value below is a local-development placeholder. None of them is safe
# anywhere else, and the API refuses to start with these JWT secrets when
# NODE_ENV is not `development`.

NODE_ENV=development
PORT=3000

# --- Data ---------------------------------------------------------------
# Host-side values. docker-compose overrides both with the service names.
# The API connects as the restricted `raeed_app` role: it has INSERT and
# SELECT on audit_log_entry and nothing else, so a compromised API still
# cannot erase the record of what it did (AUD-04).
DATABASE_URL=postgres://raeed_app:local_dev_only@localhost:5432/raeed
# The owner role, used only by `npm run migration:run`.
MIGRATION_DATABASE_URL=postgres://raeed:local_dev_only@localhost:5432/raeed
REDIS_URL=redis://localhost:6379

# --- Tokens -------------------------------------------------------------
# 15-minute access token, rotating device-scoped refresh token
# (`specs/10-security-and-privacy.md`).
JWT_ACCESS_SECRET=dev-only-access-secret-change-me
JWT_REFRESH_SECRET=dev-only-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- OTP ----------------------------------------------------------------
# With no provider key set, the API runs in console-delivery mode: the code is
# logged to the API's own stdout instead of being sent by SMS, so local
# development needs no SMS account. This is refused outside development.
OTP_PROVIDER_API_KEY=
SMS_FALLBACK_PROVIDER_API_KEY=

# --- Push ---------------------------------------------------------------
# Unset locally. The notification worker logs what it would have dispatched
# instead of calling FCM, which keeps the critical-alert pipeline observable
# without a Firebase project.
FCM_SERVICE_ACCOUNT_JSON=

# --- Storage ------------------------------------------------------------
STORAGE_DRIVER=local
STORAGE_LOCAL_ROOT=/var/lib/raeed/media

# --- Observability ------------------------------------------------------
SENTRY_DSN=

# --- Org settings -------------------------------------------------------
HIJRI_OFFSET_DAYS=0
